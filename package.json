{
  "name": "svg-reconstruction",
  "version": "0.1.0",
  "description": "Recover editable primitives, strokes and constraints from flattened SVG path soup",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "svgrec": "./bin/svgrec.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx src/bench/run.ts",
    "cli": "tsx bin/svgrec.ts",
    "dev": "vite studio",
    "typecheck": "tsc --noEmit",
    "check:studio": "svelte-check --tsconfig ./tsconfig.json --workspace studio"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^26.2.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
